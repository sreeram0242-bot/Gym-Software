generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gym {
  id           String   @id @default(uuid())
  name         String
  ownerName    String
  email        String
  phone        String
  userId       String   @unique
  passwordHash String
  status       String   @default("active")
  createdAt    String
  memberCount  Int      @default(0)

  customers    Customer[]
  attendance   AttendanceRecord[]
  transactions Transaction[]
  subscriptionPlans SubscriptionPlan[]
  whatsappSessions WhatsAppSession[]
  gymSettings  GymSettings?
}

model Customer {
  id              String   @id @default(uuid())
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  name            String
  phone           String
  nfcCardId       String
  planType        String
  feeAmount       Int
  lastPaymentDate String
  nextDueDate     String
  status          String   @default("active")
  joinedDate      String

  attendance      AttendanceRecord[]
  transactions    Transaction[]
}

model AttendanceRecord {
  id            String   @id @default(uuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  checkInTime   String
  checkOutTime  String?
  durationMinutes Int?
  dateStr       String
}

model Transaction {
  id           String   @id @default(uuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id])
  type         String
  amount       Int
  category     String
  description  String
  date         String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String?
}

model SubscriptionPlan {
  id             String @id @default(uuid())
  gymId          String
  gym            Gym    @relation(fields: [gymId], references: [id])
  name           String
  durationMonths Int
  price          Int
}

model WhatsAppSession {
  id    String @id
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  data  String // JSON stringified auth data
}

model GymSettings {
  id                    String  @id @default(uuid())
  gymId                 String  @unique
  gym                   Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  
  absentTrackingEnabled Boolean @default(false)
  absentThresholdDays   Int     @default(3)
  
  waAutoMessages        Boolean @default(true)
  waReminderWindowDays  Int     @default(3)
  
  waAttendanceMessages  Boolean @default(true)
  
  templateWelcome       String?
  templateReceipt       String?
  templateReminder      String?
  templateAbsentee      String?
  templateCheckIn       String?
  templateCheckOut      String?
}

model Announcement {
  id        String @id @default(uuid())
  title     String
  message   String
  type      String @default("info")
  createdAt String
  active    Boolean @default(true)
}
