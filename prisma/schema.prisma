generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gym {
  id           String   @id @default(uuid())
  name         String
  ownerName    String
  email        String
  phone        String
  userId       String   @unique
  passwordHash String
  status       String   @default("active")
  createdAt    String
  memberCount  Int      @default(0)

  customers         Customer[]
  attendance        AttendanceRecord[]
  transactions      Transaction[]
  subscriptionPlans SubscriptionPlan[]
  whatsappSessions  WhatsAppSession[]
  gymSettings       GymSettings?
  products          Product[]
  productSales      ProductSale[]
  staff             Staff[]
  staffAttendance   StaffAttendanceRecord[]
  biometricDevices  BiometricDevice[]
}

model Customer {
  id              String   @id @default(uuid())
  memberId        String?  @unique // Random unique ID (e.g. M-1234)
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  name            String
  phone           String
  nfcCardId       String
  nfcCardId2      String?
  fingerprintId   String?
  planType        String
  feeAmount       Int
  lastPaymentDate String
  nextDueDate     String
  pendingBalance  Int      @default(0)
  balanceDueDate  String?
  profilePic      String?  @db.Text
  status          String   @default("active")
  joinedDate      String
  waActive        Boolean  @default(false)
  lastReminderSentDate String?
  lastAbsenteeSentDate String?
  isArchived      Boolean  @default(false)

  attendance   AttendanceRecord[]
  transactions Transaction[]
  productSales ProductSale[]

  @@index([gymId])
}

model AttendanceRecord {
  id            String   @id @default(uuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  checkInTime   String
  checkOutTime  String?
  durationMinutes Int?
  dateStr       String

  @@index([gymId])
  @@index([customerId])
  @@index([dateStr])
}

model Transaction {
  id            String    @id @default(uuid())
  gymId         String
  gym           Gym       @relation(fields: [gymId], references: [id])
  type          String
  amount        Int
  category      String
  description   String
  date          String
  time          String?
  paymentMethod String    @default("CASH") // CASH, UPI, CARD, SPLIT
  splitDetails  String?   // JSON e.g. {"cash": 1000, "upi": 1000}
  upiId         String?
  upiSenderName String?
  paidAmount    Int?
  discountAmount Int      @default(0)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String?

  @@index([gymId])
  @@index([customerId])
  @@index([date])
}

model SubscriptionPlan {
  id             String @id @default(uuid())
  gymId          String
  gym            Gym    @relation(fields: [gymId], references: [id])
  name           String
  durationMonths Int
  price          Int

  @@index([gymId])
}

model WhatsAppSession {
  id    String @id
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  data  String // JSON stringified auth data
}

model Product {
  id        String @id @default(uuid())
  gymId     String
  gym       Gym    @relation(fields: [gymId], references: [id])
  name      String
  category  String @default("Supplement")
  price     Int
  stock     Int    @default(0)
  unit      String @default("unit")
  active    Boolean @default(true)
  createdAt String

  saleItems ProductSaleItem[]

  @@index([gymId])
}

model ProductSale {
  id            String   @id @default(uuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String?
  totalAmount   Int
  paymentMethod String   @default("CASH")
  splitDetails  String?
  date          String

  items ProductSaleItem[]

  @@index([gymId])
  @@index([customerId])
  @@index([date])
}

model ProductSaleItem {
  id          String      @id @default(uuid())
  saleId      String
  sale        ProductSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Int
  totalPrice  Int
}

model GymSettings {
  id                    String  @id @default(uuid())
  gymId                 String  @unique
  gym                   Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  absentTrackingEnabled Boolean @default(false)
  absentThresholdDays   Int     @default(3)

  waAutoMessages        Boolean @default(true)
  waReminderWindowDays  Int     @default(3)

  waAttendanceMessages  Boolean @default(true)
  waAutoReply           Boolean @default(true)
  waAutoArchive         Boolean @default(false)

  templateWelcome       String?
  templateReceipt       String?
  templateStoreReceipt  String?
  templateReminder      String?
  templateAbsentee      String?
  templateCheckIn       String?
  templateCheckOut      String?

  // Profile & Payments
  upiId                 String?
  upiName               String?
  address               String?

  // Feature toggles
  productsEnabled       Boolean @default(false)
  showStoreInRevenue    Boolean @default(true)

  // Attendance hardware mode: Combinable settings
  attendanceManualEnabled     Boolean @default(true)
  attendanceNfcEnabled        Boolean @default(true)
  attendanceMantraEnabled     Boolean @default(false)
  attendanceWallMountEnabled  Boolean @default(false)

  fingerprintAgentPort  Int     @default(8765)
  deviceIpAddress       String?

  // Attendance Cut-off / Auto-checkout timing (in hours)
  memberCutoffHours     Int     @default(4)
  staffCutoffHours      Int     @default(12)
}

model Announcement {
  id        String @id @default(uuid())
  title     String
  message   String
  type      String @default("info")
  createdAt String
  active    Boolean @default(true)
}

model Staff {
  id              String   @id @default(uuid())
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  name            String
  phone           String
  role            String   @default("Trainer")
  nfcCardId       String?
  fingerprintId   String?
  status          String   @default("active")
  isArchived      Boolean  @default(false)
  joinedDate      String

  attendance      StaffAttendanceRecord[]

  @@index([gymId])
}

model StaffAttendanceRecord {
  id            String   @id @default(uuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id])
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffName     String
  staffPhone    String
  checkInTime   String
  checkOutTime  String?
  durationMinutes Int?
  dateStr       String

  @@index([gymId])
  @@index([staffId])
  @@index([dateStr])
}

model BiometricDevice {
  id              String   @id @default(uuid())
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  serialNumber    String   @unique
  name            String?
  lastActive      DateTime @default(now())
  status          String   @default("offline") // online, offline
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  commands        BiometricCommand[]

  @@index([gymId])
}

model BiometricCommand {
  id              String   @id @default(uuid())
  deviceId        String
  device          BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  commandString   String   // e.g. "DATA UPDATE USERINFO PIN=105 Name=John..."
  status          String   @default("PENDING") // PENDING, SENT, COMPLETED, FAILED
  createdAt       DateTime @default(now())
  sentAt          DateTime?
  completedAt     DateTime?
  
  @@index([deviceId])
  @@index([status])
}
