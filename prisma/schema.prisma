generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gym {
  id           String   @id @default(uuid())
  name         String
  ownerName    String
  email        String
  phone        String
  userId       String   @unique
  passwordHash String
  status       String   @default("active")
  createdAt    String
  memberCount  Int      @default(0)

  customers         Customer[]
  attendance        AttendanceRecord[]
  transactions      Transaction[]
  subscriptionPlans SubscriptionPlan[]
  whatsappSessions  WhatsAppSession[]
  gymSettings       GymSettings?
  products          Product[]
  productSales      ProductSale[]
}

model Customer {
  id              String   @id @default(uuid())
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  name            String
  phone           String
  nfcCardId       String
  fingerprintId   String?
  planType        String
  feeAmount       Int
  lastPaymentDate String
  nextDueDate     String
  pendingBalance  Int      @default(0)
  balanceDueDate  String?
  status          String   @default("active")
  joinedDate      String

  attendance   AttendanceRecord[]
  transactions Transaction[]
  productSales ProductSale[]

  @@index([gymId])
}

model AttendanceRecord {
  id            String   @id @default(uuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  checkInTime   String
  checkOutTime  String?
  durationMinutes Int?
  dateStr       String

  @@index([gymId])
  @@index([customerId])
  @@index([dateStr])
}

model Transaction {
  id           String   @id @default(uuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id])
  type         String
  amount       Int
  category     String
  description  String
  date          String
  paymentMethod String    @default("CASH") // CASH, UPI, CARD, SPLIT
  splitDetails  String?   // JSON e.g. {"cash": 1000, "upi": 1000}
  paidAmount    Int?
  discountAmount Int      @default(0)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String?

  @@index([gymId])
  @@index([customerId])
  @@index([date])
}

model SubscriptionPlan {
  id             String @id @default(uuid())
  gymId          String
  gym            Gym    @relation(fields: [gymId], references: [id])
  name           String
  durationMonths Int
  price          Int

  @@index([gymId])
}

model WhatsAppSession {
  id    String @id
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  data  String // JSON stringified auth data
}

model Product {
  id        String @id @default(uuid())
  gymId     String
  gym       Gym    @relation(fields: [gymId], references: [id])
  name      String
  category  String @default("Supplement")
  price     Int
  stock     Int    @default(0)
  unit      String @default("unit")
  active    Boolean @default(true)
  createdAt String

  saleItems ProductSaleItem[]

  @@index([gymId])
}

model ProductSale {
  id            String   @id @default(uuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String?
  totalAmount   Int
  paymentMethod String   @default("CASH")
  splitDetails  String?
  date          String

  items ProductSaleItem[]

  @@index([gymId])
  @@index([customerId])
  @@index([date])
}

model ProductSaleItem {
  id          String      @id @default(uuid())
  saleId      String
  sale        ProductSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Int
  totalPrice  Int
}

model GymSettings {
  id                    String  @id @default(uuid())
  gymId                 String  @unique
  gym                   Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  absentTrackingEnabled Boolean @default(false)
  absentThresholdDays   Int     @default(3)

  waAutoMessages        Boolean @default(true)
  waReminderWindowDays  Int     @default(3)

  waAttendanceMessages  Boolean @default(true)
  waAutoReply           Boolean @default(true)
  waAutoArchive         Boolean @default(false)

  templateWelcome       String?
  templateReceipt       String?
  templateReminder      String?
  templateAbsentee      String?
  templateCheckIn       String?
  templateCheckOut      String?

  // Feature toggles
  productsEnabled       Boolean @default(false)

  // Attendance hardware mode: MANUAL | NFC | FINGERPRINT | BOTH
  attendanceMode        String  @default("NFC")
  fingerprintAgentPort  Int     @default(8765)
}

model Announcement {
  id        String @id @default(uuid())
  title     String
  message   String
  type      String @default("info")
  createdAt String
  active    Boolean @default(true)
}
